# Ayngaran Foods Backend - Environment Configuration Example
# Copy to .env and configure for your environment

DATABASE_URL="mysql://root:password@localhost:3306/ayngaran_ecommerce"
PORT=4000
NODE_ENV=development

# JWT Configuration
JWT_SECRET="your_secure_jwt_access_secret_here"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your_secure_jwt_refresh_secret_here"
JWT_REFRESH_EXPIRES_IN="24h"
ENCRYPTION_KEY="01234567890123456789012345678901"

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Customer OTP Mode: 'email' (active customer auth) or 'whatsapp' (demo/future)
OTP_PROVIDER=email
WHATSAPP_OTP_MODE=DEMO
OTP_HASHING=false

# ==========================================
# EMAIL PROVIDER
# ==========================================
# Supported values:
# - smtp        : Development / Testing (sends real email via SMTP)
# - resend      : Production (sends real email via Resend API)
# - development : Mock (prints to terminal only, real sending disabled)

# Development:
EMAIL_PROVIDER=smtp

# Production:
# EMAIL_PROVIDER=resend


# ==========================================
# SMTP - DEVELOPMENT / LOCAL TESTING
# ==========================================
# Required when EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-development-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password


# ==========================================
# RESEND - PRODUCTION
# ==========================================
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx


# ==========================================
# COMMON EMAIL CONFIG
# ==========================================
# Sender address: Must be verified in Resend (for production) or allowed by your SMTP provider
EMAIL_FROM="Ayngaran Foods <orders@ayngaranfoods.com>"

# Admin Notification Inboxes (comma-separated recipients for new order alerts)
ADMIN_ORDER_NOTIFICATION_EMAILS="admin@example.com,manager@ayngaranfoods.com"

# Portal URLs for email deep-links
CUSTOMER_PORTAL_URL="http://localhost:3000"
ADMIN_PORTAL_URL="http://localhost:3001"
