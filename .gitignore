# ===================================================
# Ayngaran Products — Monorepo .gitignore
# Backend (NestJS) + Frontend (Vite/React) + Admin (Vite/React)
# ===================================================

# ── Dependencies ──────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build Outputs ─────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/

# ── NestJS / Backend Specific ─────────────────────
backend/dist/
backend/node_modules/
backend/.env
backend/.env.*
!backend/.env.example

# ── Frontend (Vite/React) Specific ────────────────
frontend/dist/
frontend/node_modules/
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── Admin (Vite/React) Specific ───────────────────
admin/dist/
admin/node_modules/
admin/.env
admin/.env.*
!admin/.env.example

# ── Environment / Secrets ─────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env

# ── Prisma ────────────────────────────────────────
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-shm
backend/prisma/*.db-wal

# ── Logs ──────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Cache / Temp ──────────────────────────────────
.cache/
.parcel-cache/
.vite/
.turbo/
.eslintcache
*.tsbuildinfo

# ── OS / Editor ───────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Test Coverage ─────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Upload / Static Media (keep tracked if needed) ─
# uploads/
# public/uploads/

# ── Misc ──────────────────────────────────────────
*.pem
.vercel
.netlify
